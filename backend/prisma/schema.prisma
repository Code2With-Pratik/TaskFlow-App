generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProjectRole {
  OWNER
  ADMIN
  MEMBER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_STATUS_UPDATED
  COMMENT_ADDED
  COMMENT_MENTIONED
  PROJECT_INVITATION
  TASK_DUE_SOON
  TASK_OVERDUE
  TASK_BLOCKED
  GITHUB_REVIEW_REQUESTED
  GITHUB_CHECK_FAILED
  GITHUB_PULL_REQUEST_MERGED
}

enum ProjectInvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum GitHubWorkType {
  ISSUE
  PULL_REQUEST
}

model User {
  id                         String               @id @default(uuid()) @db.Uuid
  name                       String
  email                      String               @unique
  passwordHash               String
  refreshTokenHash           String?
  avatar                     String?
  designation                String?
  createdAt                  DateTime             @default(now())
  updatedAt                  DateTime             @updatedAt
  ownedProjects              Project[]            @relation("ProjectOwner")
  memberships                ProjectMember[]
  taskAssignments            TaskAssignee[]
  createdTasks               Task[]               @relation("TaskCreator")
  comments                   Comment[]
  notifications              Notification[]
  activities                 Activity[]
  sentProjectInvitations     ProjectInvitation[]  @relation("ProjectInvitationSender")
  receivedProjectInvitations ProjectInvitation[]  @relation("ProjectInvitationRecipient")
  githubInstallations        GitHubInstallation[] @relation("GitHubInstallationConnector")
  githubLinks                TaskGitHubLink[]
  commentMentions            CommentMention[]

  @@index([name])
}

model Project {
  id                  String              @id @default(uuid()) @db.Uuid
  name                String
  description         String?
  ownerId             String              @db.Uuid
  autoCompleteOnMerge Boolean             @default(false)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  owner               User                @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members             ProjectMember[]
  tasks               Task[]
  activities          Activity[]
  invitations         ProjectInvitation[]
  githubInstallation  GitHubInstallation?

  @@index([ownerId])
}

model ProjectMember {
  id        String      @id @default(uuid()) @db.Uuid
  projectId String      @db.Uuid
  userId    String      @db.Uuid
  role      ProjectRole @default(MEMBER)
  joinedAt  DateTime    @default(now())
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

model Task {
  id          String           @id @default(uuid()) @db.Uuid
  title       String
  description String?
  status      TaskStatus       @default(TODO)
  priority    TaskPriority     @default(MEDIUM)
  projectId   String           @db.Uuid
  createdById String           @db.Uuid
  dueDate     DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignees   TaskAssignee[]
  createdBy   User             @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict)
  comments    Comment[]
  githubLinks TaskGitHubLink[]

  @@index([projectId, status])
  @@index([createdById])
  @@index([dueDate])
}

model TaskAssignee {
  taskId     String   @db.Uuid
  userId     String   @db.Uuid
  assignedAt DateTime @default(now())
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@index([userId])
}

model Comment {
  id        String           @id @default(uuid()) @db.Uuid
  content   String
  parentId  String?          @db.Uuid
  imageData String?
  taskId    String           @db.Uuid
  userId    String           @db.Uuid
  createdAt DateTime         @default(now())
  task      Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent    Comment?         @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[]        @relation("CommentReplies")
  mentions  CommentMention[]

  @@index([taskId, createdAt])
  @@index([userId])
  @@index([parentId, createdAt])
}

model CommentMention {
  commentId String   @db.Uuid
  userId    String   @db.Uuid
  createdAt DateTime @default(now())
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([commentId, userId])
  @@index([userId, createdAt])
}

model ProjectInvitation {
  id            String                  @id @default(uuid()) @db.Uuid
  projectId     String                  @db.Uuid
  inviterId     String                  @db.Uuid
  inviteeId     String                  @db.Uuid
  role        ProjectRole             @default(MEMBER)
  status        ProjectInvitationStatus @default(PENDING)
  createdAt     DateTime                @default(now())
  respondedAt   DateTime?
  project       Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  inviter       User                    @relation("ProjectInvitationSender", fields: [inviterId], references: [id], onDelete: Cascade)
  invitee       User                    @relation("ProjectInvitationRecipient", fields: [inviteeId], references: [id], onDelete: Cascade)
  notifications Notification[]

  @@unique([projectId, inviteeId])
  @@index([inviteeId, status])
}

model GitHubInstallation {
  id             String             @id @default(uuid()) @db.Uuid
  projectId      String             @unique @db.Uuid
  installationId Int
  accountLogin   String
  isActive       Boolean            @default(true)
  connectedById  String             @db.Uuid
  createdAt      DateTime           @default(now())
  project        Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  connectedBy    User               @relation("GitHubInstallationConnector", fields: [connectedById], references: [id], onDelete: Restrict)
  repositories   GitHubRepository[]

  @@index([installationId])
}

model GitHubRepository {
  id             String             @id @default(uuid()) @db.Uuid
  installationId String             @db.Uuid
  githubRepoId   String
  fullName       String
  defaultBranch  String
  isPrivate      Boolean            @default(false)
  installation   GitHubInstallation @relation(fields: [installationId], references: [id], onDelete: Cascade)
  taskLinks      TaskGitHubLink[]

  @@unique([installationId, githubRepoId])
  @@unique([installationId, fullName])
}

model TaskGitHubLink {
  id           String           @id @default(uuid()) @db.Uuid
  taskId       String           @db.Uuid
  repositoryId String           @db.Uuid
  addedById    String           @db.Uuid
  number       Int
  type         GitHubWorkType
  url          String
  title        String
  state        String
  isDraft      Boolean          @default(false)
  reviewState  String?
  checkStatus  String?
  mergedAt     DateTime?
  syncedAt     DateTime         @default(now())
  task         Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  repository   GitHubRepository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  addedBy      User             @relation(fields: [addedById], references: [id], onDelete: Cascade)

  @@unique([repositoryId, number, type])
  @@index([taskId, syncedAt])
}

model Notification {
  id                  String             @id @default(uuid()) @db.Uuid
  title               String
  message             String
  type                NotificationType
  userId              String             @db.Uuid
  isRead              Boolean            @default(false)
  href                String?
  projectInvitationId String?            @db.Uuid
  createdAt           DateTime           @default(now())
  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectInvitation   ProjectInvitation? @relation(fields: [projectInvitationId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
}

model Activity {
  id          String   @id @default(uuid()) @db.Uuid
  action      String
  description String
  projectId   String   @db.Uuid
  userId      String   @db.Uuid
  createdAt   DateTime @default(now())
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([userId, createdAt])
}
